      "writtenOn": "2026-04-22T06:41:03Z",
      "side": 1,
      "message": "I think the point is to always use the same virtual build path across all workspaces and users (and bots). So, I would rather not to provide a way to override the default path.",
      "parentUuid": "df9c3fd3_9249ada0",
      "range": {
        "startLine": 525,
        "startChar": 36,
        "endLine": 525,
        "endChar": 59
      },
