      "writtenOn": "2026-01-07T15:42:22Z",
      "side": 1,
      "message": "running `./format.py foo.py` should format the file `foo.py`\n\ni know it feels a little bikeshedding, but such a proposal feels like it at least needs a 1 pager to cover use cases \u0026 expectations.  trying to design the interface on the fly while coding will make it that much harder to change once people start using it.",
      "parentUuid": "8c5ef256_40f4d4db",
      "range": {
        "startLine": 13,
        "startChar": 0,
        "endLine": 15,
        "endChar": 54
      },
      "revId": "622ee23b86b073429f903968312c3f92757913ea",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
