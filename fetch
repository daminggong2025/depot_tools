base_dir=$(dirname "$0")

# Prepend python-bin to PATH so subprocesses use CIPD Python, and ensure
# depot_tools is on PATH for standalone usage.
base_dir_abs=$(cd "$base_dir" 2>/dev/null && pwd -P || echo "$base_dir")
PATH=$base_dir_abs/python-bin:$PATH:$base_dir_abs

PYTHONDONTWRITEBYTECODE=1 exec vpython3 "$base_dir/fetch.py" "$@"
