      },
      "writtenOn": "2026-07-10T03:43:55Z",
      "side": 1,
      "message": "Oh, ruff_chromium isn\u0027t just ruff. It may call yapf. The wrapper name is confusing, I guess.",
      "parentUuid": "0a86c63f_ae322697",
      "range": {
        "startLine": 7379,
        "startChar": 57,
        "endLine": 7379,
        "endChar": 70
