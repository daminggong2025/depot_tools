# This wrapper shadows 'uv' to automatically maintain the hermetic environment.
# It runs setup_uv_env.py (which fast-exits if up-to-date), then execs the real uv.

set -e

# Define paths
REPO_ROOT="$(dirname "${BASH_SOURCE[0]}")"
SETUP_SCRIPT="$REPO_ROOT/setup_uv.py"

# Always run the setup script. It handles its own staleness check.
python3 "$SETUP_SCRIPT"

# Find the real 'uv' executable.
# We iterate through PATH, skipping this script itself.
THIS_INODE=$(ls -i "$0" | awk '{print $1}')

REAL_UV=""
IFS=':' read -ra ADDR <<< "$PATH"
for dir in "${ADDR[@]}"; do
    if [ -z "$dir" ]; then continue; fi
    
    CANDIDATE="$dir/uv"
    if [ -x "$CANDIDATE" ] && [ -f "$CANDIDATE" ]; then
        CAND_INODE=$(ls -i "$CANDIDATE" 2>/dev/null | awk '{print $1}' || echo "")
        if [ "$CAND_INODE" != "$THIS_INODE" ]; then
            REAL_UV="$CANDIDATE"
            break
        fi
    fi
done

if [ -z "$REAL_UV" ]; then
    # Fallback search
    if command -v ~/.cargo/bin/uv >/dev/null 2>&1; then
        REAL_UV=~/.cargo/bin/uv
    elif command -v ~/.local/bin/uv >/dev/null 2>&1; then
        REAL_UV=~/.local/bin/uv
    else
        echo "Error: Could not find the system 'uv' executable in PATH."
        echo "Please ensure uv is installed and in your PATH (after depot_tools)."
        exit 127
    fi
fi

exec "$REAL_UV" "$@"