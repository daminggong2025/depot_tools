[
  {
    "cmd": [
      "vpython3",
      "RECIPE_REPO[depot_tools]/gerrit_client.py",
      "changes",
      "--host",
      "https://fake-host-review.googlesource.com",
      "--json_file",
      "/path/to/tmp/json",
      "--limit",
