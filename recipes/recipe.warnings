google_issue_default {
  host: "crbug.com"
}
warning {
  name: "TRYSERVER_GERRIT_CHANGE_PROPERTIES"
  description: "Gerrit change details have been encapsulated in the"
  description: "GerritChange type which provides properties for the various"
  description: "associated details that was previsouly exposed via properties"
  description: "of the tryserver module."
  description: "After checking that tryserver.gerrit_change is true, the uses"
  description: "should be updated as follows:"
  description: ""
  description: "1) `tryserver.gerrit_change_repo_url` should be replaced with"
  description: "`tryserver.gerrit_change.repo_url`."
  description: ""
  description: "2) `tryserver.gerrit_change_repo_host` should be replaced with"
  description: "`tryserver.gerrit_change.repo_host`."
  description: ""
  description: "3) `tryserver.gerrit_change_repo_project` should be replaced"
  description: "with `tryserver.gerrit_change.project`."
  description: ""
  description: "4) `tryserver.gerrit_change_owner` should be replaced with"
  description: "`tryserver.gerrit_change.owner`."
  description: ""
  description: "5) `tryserver.gerrit_change_review_url` should be replaced with"
  description: "`tryserver.gerrit_change.review_url`."
  description: ""
  description: "6) `tryserver.gerrit_change_fetch_ref` should be replaced with"
  description: "`tryserver.gerrit_change.fetch_ref`."
  description: ""
  description: "7) `tryserver.gerrit_change_target_ref` should be replaced with"
  description: "`tryserver.gerrit_change.target_ref`."
  description: ""
  description: "8) `tryserver.gerrit_change_number` should be replaced with"
  description: "`tryserver.gerrit_change.change`."
  description: ""
  description: "9) `tryserver.gerrit_patchset_number` should be replaced with"
  description: "`tryserver.gerrit_change.patchset`."
  description: ""
  description: "10) `tryserver.get_footers()` should be replaced with"
  description: "`tryserver.gerrit_change.footers`. Note that this does not"
  description: "apply when providing a non-None patch_text."
  description: ""
  description: "11) `tryserver.get_footer(<tag>)` should be replaced with"
  description: "`tryserver.gerrit_change.get_footer(<tag>)`. Note that this"
  description: "does not apply when providing a non-None patch_text."
  description: ""
  description: "12) `tryserver.get_change_description()` should be replaced"
  description: "with `tryserver.gerrit_change.commit_message`."
  # DO NOT SUBMIT - open up a bug and update bug number
  google_issue { id: 1 }
}
