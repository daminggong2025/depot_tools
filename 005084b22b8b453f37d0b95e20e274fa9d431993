      "writtenOn": "2025-07-29T16:36:58Z",
      "side": 1,
      "message": "It\u0027ll put a key-val pairs in the [\"output\"][\"properties\"] section of what bb returns, eg: `bb get -json -A $BUILD_ID | jq .output.properties`",
      "parentUuid": "d3cb485d_8c4eedd9",
      "range": {
        "startLine": 116,
