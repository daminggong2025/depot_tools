base_dir=$(dirname "$0")
base_dir_abs=$(cd "$base_dir" 2>/dev/null && pwd -P)

# Forward directly to hermetic CIPD Python unless DEPOT_TOOLS_PYTHON_BYPASS is set.
if [[ -z "$DEPOT_TOOLS_PYTHON_BYPASS" || "$DEPOT_TOOLS_PYTHON_BYPASS" == "0" ]]; then
  if [[ ! -f "$base_dir_abs/python3_bin_reldir.txt" ]]; then
    echo "depot_tools: Error: python3_bin_reldir.txt not found. Initialize depot_tools by running gclient or update_depot_tools." >&2
    exit 1
  fi
  if [[ "$OSTYPE" == "msys" ]]; then
    python_bin_dir="$base_dir_abs/$(sed -e 's-\\-/-g' "$base_dir_abs/python3_bin_reldir.txt")"
  else
    python_bin_dir="$base_dir_abs/$(<"$base_dir_abs/python3_bin_reldir.txt")"
  fi
  export PATH="$python_bin_dir:$python_bin_dir/Scripts:$PATH"
  exec "$python_bin_dir/python3" "$@"
fi

# Bypass mode: Search PATH for the first 'python3' or 'python' binary outside depot_tools.
#
# To prevent infinite recursion (e.g. when depot_tools is near the start of PATH,
# or when a PATH entry symlinks back to depot_tools/python3):
# 1. Ignore any PATH directory residing inside depot_tools.
# 2. Use readlink/realpath to resolve symlinks and check if the underlying file
#    or target directory belongs to depot_tools.
# 3. Track if a symlink back to depot_tools was encountered so we can display a
#    clear error message if no valid system Python is found.
sys_python=""
found_symlink_to_depot_tools=0
OLD_IFS="$IFS"
IFS=":"
for dir in $PATH; do
  IFS="$OLD_IFS"
  [ -z "$dir" ] && continue
  dir_abs=$(cd "$dir" 2>/dev/null && pwd -P)
  [ -z "$dir_abs" ] && continue

  # Skip PATH directories residing inside depot_tools.
  if [[ "$dir_abs" == "$base_dir_abs" || "$dir_abs" == "$base_dir_abs"/* ]]; then
    continue
  fi

  for target_bin in python3 python; do
    candidate="$dir/$target_bin"
    if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then
      is_depot_tools_file=0
      # Check direct inode equality (-ef) against depot_tools scripts.
      if [ "$candidate" -ef "$0" ] || [ "$candidate" -ef "$base_dir_abs/python3" ] || [ "$candidate" -ef "$base_dir_abs/python-bin/python3" ]; then
        is_depot_tools_file=1
      else
        # Resolve symlink to check if the target resides inside depot_tools.
        real_target=$(readlink -f "$candidate" 2>/dev/null || realpath "$candidate" 2>/dev/null || echo "")
        if [ -n "$real_target" ]; then
          real_target_dir=$(cd "$(dirname "$real_target")" 2>/dev/null && pwd -P)
          if [[ "$real_target_dir" == "$base_dir_abs" || "$real_target_dir" == "$base_dir_abs"/* ]]; then
            is_depot_tools_file=1
          fi
        fi
      fi

      if [ $is_depot_tools_file -eq 1 ]; then
        found_symlink_to_depot_tools=1
        continue
      fi
      sys_python="$candidate"
      break 2
    fi
  done
done
IFS="$OLD_IFS"

if [ -n "$sys_python" ]; then
  exec "$sys_python" "$@"
fi

if [ $found_symlink_to_depot_tools -eq 1 ]; then
  echo "depot_tools: Error: symlinks back to depot_tools." >&2
  exit 1
fi

echo "depot_tools: Error: System python3/python not found in PATH (bypass enabled)." >&2
exit 1
